# Replace placeholders; run ./prepare.sh first to generate secrets.
COMPOSE_PROJECT_NAME=homelab-sparkice
# Keycloak realm from existing Outline deployment; client is NEW.
KEYCLOAK_ISSUER=https://keycloak.handyman.moscow/realms/REPLACE_REALM
KEYCLOAK_CLIENT_ID=jupyterhub
KEYCLOAK_CLIENT_SECRET=REPLACE_KEYCLOAK_SECRET
JUPYTERHUB_PUBLIC_URL=https://jupyter.handyman.moscow
# Keycloak's preferred_username (not necessarily the GitHub username).
JUPYTERHUB_ALLOWED_USERS=REPLACE_USERNAME
JUPYTERHUB_ADMIN_USERS=
# Dedicated RustFS S3 account: bucket home-iceberg, not Outline admin credentials.
RUSTFS_ACCESS_KEY_ID=REPLACE_RUSTFS_ACCESS_KEY
RUSTFS_SECRET_ACCESS_KEY=REPLACE_RUSTFS_SECRET_KEY
AWS_REGION=us-east-1
ICEBERG_BUCKET=home-iceberg
# prepare.sh generates secure random password on first run.
ICEBERG_DB_PASSWORD=GENERATE_WITH_PREPARE
